{
  "schemaVersion": 1,
  "id": "kthreadd",
  "version": "${version}",
  "name": "KTHREADD",
  "description": "KTHREADD PvP development expansion for Minecraft 1.20.4 Fabric. Full parity and runtime verification are incomplete; see PVP-MODERNIZATION-PLAN.md.",
  "authors": [
    "KTHREADD modernization contributors"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.kthreadd.KthreaddClient"
    ]
  },
  "mixins": [
    "kthreadd.mixins.json",
    "kthreadd-pvp.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.11",
    "minecraft": "1.20.4",
    "java": ">=17",
    "fabric-api": ">=0.97.2+1.20.4"
  }
}
